DEEPSEEK_API_KEY=your_deepseek_api_key_here
QDRANT_URL=http://localhost:6333

# Clustering — deterministic seed (0 = random each run)
CLUSTER_SEED=42

# Moat threshold — max centroid similarity to qualify as a knowledge moat
# Default 0.5 works for most corpora. Raise to 0.65 for dense esoteric/metaphysical corpora
# where all clusters share significant vocabulary (e.g. meta_reflections).
MOAT_THRESHOLD=0.5

# Filter degenerate clusters (density=1.0 / coherence=1.0) from bridge and moat analysis.
# These are null-content clusters (page numbers, index markers, section headers).
# Set to false only if you want to see them in cross-cluster analysis.
FILTER_DEGENERATE=true
